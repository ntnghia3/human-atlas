  "legacyCategoryInterpretations": {
    "FMA_EQUIVALENT_TO_SNOMED_ENTIRE": {
      "relationType": "EXACT_ENTITY_EQUIVALENT",
      "sepClass": "E"
    },
    "SNOMED_STRUCTURE_BROADER_THAN_FMA": {
      "relationType": "FMA_SUBCLASS_OF_SNOMED",
      "sepClass": "S"
    },
    "SNOMED_PART_NARROWER_THAN_FMA": {
      "deprecated": true,
      "replacement": "SNOMED_PROPER_PART_OF_FMA only when a proper-part proof exists; not class subsumption"
    },
    "FMA_BROADER_THAN_SNOMED": {
      "relationType": "SNOMED_SUBCLASS_OF_FMA"
    },
    "LATERALITY_EXACT_EQUIVALENT": {
      "axis": "lateralityRelation",
      "value": "EXACT",
      "impliesEntityEquivalence": false
    },
    "LEXICAL_ONLY_CANDIDATE": {
      "bridgeConfidenceClass": "T6"
    },
    "NO_FMA_COUNTERPART": {
      "replacement": "NO_ATLAS_COUNTERPART",
      "requires": "reviewed exhaustion certificate for the fixed atlas universe"
    }
  },
  "normalizationPolicy": {
    "rawFieldsImmutable": true,
    "allowedDiscoveryTransforms": [
      "Unicode NFC",
      "trim edge whitespace",
      "collapse layout whitespace",
      "case folding in an additional discovery key only"
    ],
    "protectedTokens": [
      "entire",
      "structure",
      "body structure",
      "part",
      "right",
      "left",
      "bilateral",
      "branch",
      "tributary",
      "segment",
      "region",
      "subdivision",
      "group",
      "set",
      "tissue",
      "organ"
    ],
    "forbidden": [
      "qualifier deletion",
      "diacritic deletion for agreement",
      "stemming that merges singular and plural",
      "token sorting",
      "side composition",
      "AI translation",
      "generated Vietnamese terms"
    ],
    "legacyAliases": "retain unchanged as discovery-only; cannot establish equivalence or direct equality"
  },
