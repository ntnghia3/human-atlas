  "crossRecordInvariants": [
    {
      "id": "I01",
      "assertion": "Every raw corpus line is represented once by rowId = SHA256(corpusSha256 + ':' + 1-based line number + ':' + rawLineSha256); preserve original line bytes."
    },
    {
      "id": "I02",
      "assertion": "Every pair references one existing row and pinned FMA/SNOMED endpoints; SCTIDs are strings; concept partition/check digit and source field adapter are validated."
    },
    {
      "id": "I03",
      "assertion": "Every PASS check has at least one source/assertion evidenceRef supporting that check; UNKNOWN never satisfies exact eligibility. A reviewer assertion may supply explicit scope proof."
    },
    {
      "id": "I04",
      "assertion": "Eligible pair relation is exact, tier T0/T1/T2, zero blockers, all exact gates pass; productionEligible=false always."
    },
    {
      "id": "I05",
      "assertion": "For a MOH bridge, bridge.snomed.id == sourceRow.snomedId == pair.snomed.id. A separate E partner is not substitutable for an S row."
    },
    {
      "id": "I06",
      "assertion": "T0 requires explicit source FMA identity; T1 registry admission; T2 named human ontology review. Neither CUI nor local inference can create any of these."
    },
    {
      "id": "I07",
      "assertion": "Exactly 1506 rowDecision records, unique rowId set identical to source ledger; acceptedFmaId/selectedPairId nonnull exactly for eligible rows."
    },
    {
      "id": "I08",
      "assertion": "At most one distinct accepted FMA target per source row; multiple compatible trusted or credible unresolved targets yield IDENTITY_REVIEW."
    },
    {
      "id": "I09",
      "assertion": "NO_ATLAS_COUNTERPART requires a versioned, human-reviewed exhaustionCertificateId; zero lexical hits alone yields NO_CANDIDATE_FOUND."
    },
    {
      "id": "I10",
      "assertion": "Any file exported publicly and every transitive evidence dependency must have export clearance; identifiers-only does not remove license dependencies."
    },
    {
      "id": "I11",
      "assertion": "All provenance and proof graphs are acyclic; approved equivalence assertions are direct in v1; preserve edge type/direction and stated/inferred/additional characteristic."
    },
    {
      "id": "I12",
      "assertion": "Same inputs and policy produce byte-identical decisions; timestamps are manifest metadata outside decision hashes; deterministic sorted blocker and rule traces."
    },
    {
      "id": "I13",
      "assertion": "UNDETERMINED is not DISJOINT; proper part, member_of, located_in and is_a are not interchangeable."
    },
    {
      "id": "I14",
      "assertion": "Independent baseline evidence remains eligible; MOH interaction flags cannot remove it. Public profile never reads or depends on local restricted evidence."
    }
  ]
