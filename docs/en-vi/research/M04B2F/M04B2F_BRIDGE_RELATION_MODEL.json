{
  "schemaVersion": "m04b2f-relation-model-proposal-1",
  "status": "PROPOSED_RESEARCH_ARCHITECTURE_ONLY",
  "researchDate": "2026-09-21",
  "orientation": "F=FMA class, S=SNOMED class; names never define the relation",
  "relations": [
    {
      "id": "EXACT_ENTITY_EQUIVALENT",
      "definition": "F and S denote the same anatomical class under pinned interpretations.",
      "proofRequirement": "Approved exact assertion plus complete compatible scope evidence.",
      "canSupportExactEvidence": true
    },
    {
      "id": "FMA_SUBCLASS_OF_SNOMED",
      "definition": "Every F instance is an S instance; proper class inclusion is positively established.",
      "proofRequirement": "Typed subclass proof; spatial parthood does not suffice.",
      "canSupportExactEvidence": false
    },
    {
      "id": "SNOMED_SUBCLASS_OF_FMA",
      "definition": "Every S instance is an F instance; proper class inclusion is positively established.",
      "proofRequirement": "Typed subclass proof; P(X) is not thereby a subtype of entire X.",
      "canSupportExactEvidence": false
    },
    {
      "id": "FMA_PROPER_PART_OF_SNOMED",
      "definition": "Every F instance is a proper anatomical part of some S instance.",
      "proofRequirement": "Explicit typed parthood evidence; neither subclass nor identity.",
      "canSupportExactEvidence": false
    },
    {
      "id": "SNOMED_PROPER_PART_OF_FMA",
      "definition": "Every S instance is a proper anatomical part of some F instance.",
      "proofRequirement": "Explicit typed parthood evidence; generic P classes need their own scope.",
      "canSupportExactEvidence": false
    },
    {
      "id": "OVERLAP_NON_EQUIVALENT",
      "definition": "Positive evidence establishes shared scope and a boundary difference.",
      "proofRequirement": "Witnessed overlap and witnessed difference, not merely no equality proof.",
      "canSupportExactEvidence": false
    },
    {
      "id": "DISJOINT",
      "definition": "Positive evidence establishes incompatible class extensions.",
      "proofRequirement": "Disjointness assertion or approved incompatibility proof; unknown is not disjoint.",
      "canSupportExactEvidence": false
    },
    {
      "id": "UNDETERMINED",
      "definition": "Available evidence does not establish a semantic relation.",
      "proofRequirement": "Default when positive proof is absent or contradictory.",
      "canSupportExactEvidence": false
    }
  ],
  "orthogonalAxes": {
    "sepClass": [
      "S",
      "E",
      "P",
      "NOT_APPLICABLE",
      "UNKNOWN",
      "CONFLICTING"
    ],
    "lateralityRelation": [
      "EXACT",
