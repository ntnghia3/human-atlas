        "baselineResultSha256",
        "baselineConceptSetSha256",
        "policyVersion",
        "policySha256",
        "adapterVersions",
        "sourceArtifacts",
        "bridgeRegistrySha256",
        "licenseRegistrySha256",
        "normalizationVersion",
        "candidateGenerationVersion",
        "ontologyReviewLedgerSha256",
        "expectedRowCount",
        "expectedAtlasCount",
        "canonicalization"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "PUBLIC_OFFLINE",
            "LICENSED_LOCAL"
          ]
        },
        "atlasSha256": {
          "type": "string",
          "minLength": 1
        },
        "mohCorpusSha256": {
          "type": "string",
          "minLength": 1
        },
        "baselineResultSha256": {
          "type": "string",
          "minLength": 1
        },
        "baselineConceptSetSha256": {
          "type": "string",
          "minLength": 1
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "policySha256": {
          "type": "string",
          "minLength": 1
        },
        "adapterVersions": {
          "type": "array",
          "items": {
            "type": "string",
